#!/usr/bin/env bash
# claude-statusline: Claude Code status line.
# Shows model, context use and plan limits, and saves the limits to
# ~/.cache/ai-usage/claude.json (or $AI_USAGE_CLAUDE_FILE) for ai-usage.
input=$(cat)
cache_file="${AI_USAGE_CLAUDE_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/ai-usage/claude.json}"
cache_dir=$(dirname "$cache_file")

if printf '%s' "$input" | jq -e '.rate_limits | type == "object"' >/dev/null 2>&1; then
  mkdir -p "$cache_dir"
  tmp=$(mktemp "$cache_dir/claude.XXXXXX")
  # Claude Code can leave out a window it has nothing new for, so merge the
  # new reading over the last one instead of replacing it.
  previous=$(jq -c 'objects' "$cache_file" 2>/dev/null)
  [ -n "$previous" ] || previous='{}'
  if printf '%s' "$input" | jq -c --argjson prev "$previous" \
      '{saved_at: now, model: .model.display_name, rate_limits: (($prev.rate_limits // {}) * .rate_limits)}' > "$tmp"; then
    mv "$tmp" "$cache_file"
  else
    rm -f "$tmp"
  fi
fi

# Show the merged limits too, skipping any window that has already reset.
saved=$(jq -c '.rate_limits | objects' "$cache_file" 2>/dev/null)
[ -n "$saved" ] || saved='{}'
printf '%s' "$input" | jq -r --argjson saved "$saved" '
  def pct: if . == null then "?" else (floor | tostring) + "%" end;
  def live: select(. != null and (.resets_at == null or .resets_at > now));
  ($saved * (.rate_limits // {})) as $limits
  | [ .model.display_name,
      "ctx " + (.context_window.used_percentage | pct),
      ($limits.five_hour | live | "5h " + (.used_percentage | pct)),
      ($limits.seven_day | live | "7d " + (.used_percentage | pct))
    ] | join(" · ")'
